<%- include("partials/admin-shell-start", { pageTitle, currentSection: "staff-awards", pageHeading: hospital, pageIntro: "Awards administration", pageBodyClass: "staff-awards-admin" }) %>
<section class="awards-admin">
  <nav class="awards-crumb" aria-label="Breadcrumb"><a href="/admin">Administration</a> / <span>Staff Awards</span></nav>
  <header class="awards-heading">
    <div><h2>Staff award nominations</h2><p>2026 awards cycle</p></div>
    <a class="awards-button awards-primary" href="/staff-awards">Open nomination form</a>
  </header>
  <% if (error) { %><p class="awards-message awards-error" role="alert"><%= error %></p><% } %>
  <% if (feedback) { %><p class="awards-message" role="status"><%= feedback %></p><% } %>
  <form class="awards-toolbar" action="/admin/staff-awards" method="get" role="search">
    <input type="search" name="q" aria-label="Search by nominee or employee number" placeholder="Search by nominee or employee number" value="<%= q %>" maxlength="120" />
    <select name="category" aria-label="Award category">
      <option value="">All award categories</option>
      <% for (const option of categories) { %><option <%= option === category ? 'selected' : '' %>><%= option %></option><% } %>
    </select>
    <button class="awards-button" type="submit">Search</button>
    <% if (q || category) { %><a href="/admin/staff-awards">Clear</a><% } %>
    <span class="awards-count"><%= total %> <%= total === 1 ? 'nomination' : 'nominations' %></span>
  </form>

  <div class="awards-workspace">
    <div>
      <div class="awards-register">
        <table aria-label="Staff award nominations">
          <thead><tr><th scope="col">Nominee</th><th scope="col">Award category</th><th scope="col">Submitted</th></tr></thead>
          <tbody>
            <% for (const row of nominations) { %>
              <tr class="<%= selected?.id === row.id ? 'awards-selected' : '' %>">
                <td><a href="<%= pageUrl({ id: row.id }) %>#award-details" <%= selected?.id === row.id ? 'aria-current=true' : '' %>><%= row.nominee %></a></td>
                <td><%= row.category %></td><td><time><%= row.submitted_at.slice(0, 16) %> UTC</time></td>
              </tr>
            <% } %>
            <% if (!nominations.length) { %><tr><td colspan="3">No nominations found.</td></tr><% } %>
          </tbody>
        </table>
      </div>
      <% if (before || nextId) { %>
        <nav class="awards-pages" aria-label="Nomination pages">
          <% if (before) { %><a href="<%= pageUrl({ before: null }) %>">Newest nominations</a><% } %>
          <% if (nextId) { %><a href="<%= pageUrl({ before: nextId }) %>">Older nominations</a><% } %>
        </nav>
      <% } %>
    </div>

    <section class="awards-review" id="award-details" aria-labelledby="awards-detail-heading">
      <h3 id="awards-detail-heading"><%= mode === 'edit' && selected ? 'Edit nomination' : 'Nomination details' %></h3>
      <div class="awards-review-inner">
        <% if (!selected) { %>
          <p>Select a nomination to review its details.</p>
        <% } else if (mode === 'edit') { %>
          <%- include("partials/staff-award-edit", { values, selected, token, version, pageUrl, categories, staffFields, rubric }) %>
        <% } else { %>
          <h4><%= values.nominee_name %></h4>
          <p class="awards-category"><%= values.category %></p>
          <p class="awards-meta"><%= values.nominationType === 'self' ? 'Self nomination' : 'Peer nomination' %> · <%= values.nominee_department %></p>
          <% if (mode === 'delete') { %>
            <form class="awards-confirm" action="<%= pageUrl({ id: selected.id, action: 'delete' }) %>" method="post">
              <input type="hidden" name="token" value="<%= token %>" />
              <input type="hidden" name="version" value="<%= version %>" />
              <p>Delete this nomination for <strong><%= values.nominee_name %></strong>? It will be removed from the register.</p>
              <div class="awards-actions">
                <button class="awards-button awards-primary" type="submit">Confirm delete</button>
                <a class="awards-button" href="<%= pageUrl({ id: selected.id }) %>#award-details">Cancel</a>
              </div>
            </form>
          <% } else { %>
            <div class="awards-actions">
              <a class="awards-button" href="<%= pageUrl({ id: selected.id, action: 'edit' }) %>#award-details">Edit</a>
              <a class="awards-button awards-danger" href="<%= pageUrl({ id: selected.id, action: 'delete' }) %>#award-details">Delete</a>
            </div>
          <% } %>
          <h5>Competency ratings</h5>
          <dl class="awards-scores">
            <% for (const [, items] of rubric) { for (const [key, title] of items) { %>
              <div><dt><%= title %></dt><dd><%= values[key] %></dd></div>
            <% } } %>
          </dl>
          <p class="awards-meta">Attendance and appraisal are reviewed separately.</p>
          <% for (const [prefix, label] of [['nominee', 'Nominee information'], ['nominator', 'Nominator information']]) { %>
            <% if (prefix === 'nominator' && values.nominationType === 'self') continue; %>
            <details><summary><%= label %></summary><dl class="awards-scores">
              <% for (const [key, title] of staffFields) { %><div><dt><%= title %></dt><dd><%= values[prefix + '_' + key] %></dd></div><% } %>
              <% if (prefix === 'nominee') { %><div><dt>Years worked</dt><dd><%= values.years %></dd></div><% } %>
            </dl></details>
          <% } %>
          <details><summary>Nomination reasons and innovation</summary>
            <p class="awards-response"><%= values.reasons %></p>
            <% if (values.idea) { %>
              <strong>Innovation example</strong><p class="awards-response"><%= values.idea %></p>
              <strong>Implementation</strong><p class="awards-response"><%= values.implementation %></p>
            <% } %>
          </details>
        <% } %>
      </div>
    </section>
  </div>
</section>
<%- include("partials/admin-shell-end") %>
